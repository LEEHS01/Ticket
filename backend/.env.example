# 복사해서 .env 로 쓰세요: cp .env.example .env   (.env는 .dockerignore에 의해 이미지에 들어가지 않습니다)
# 아래 값은 docker-compose.dev.yml 과 짝을 이루는 "개발용 가짜 값"입니다. 운영 비밀값을 여기에 적지 마세요.
# 호스트(DB_HOST/REDIS_HOST)는 앱 컨테이너를 compose 네트워크(tkbe-dev_default)에 붙여 실행할 때 기준입니다.

# --- MySQL (필수: DB_HOST, DB_USER, DB_PASSWORD) ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=ticketing
# API 서버는 최소 권한 계정. migrate 모드는 DB_USER=ticketing / DB_PASSWORD=dev-only-migrate-pw 로 실행
DB_USER=ticketing_app
DB_PASSWORD=dev-only-app-pw
DB_SSL_MODE=PREFERRED
DB_POOL_SIZE=10

# --- Redis (필수: REDIS_HOST) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=dev-only-redis-pw
REDIS_SSL=false
REDIS_DATABASE=0

# --- 요청 제한 (IP당, 1분) ---
RATE_LIMIT_GENERAL_PER_MINUTE=120
RATE_LIMIT_STRICT_PER_MINUTE=30

# --- CORS (기본 비활성. Vite 개발 서버를 프록시 없이 붙일 때만) ---
CORS_ALLOWED_ORIGINS=

# --- 대기열·좌석 선점 (ARCHITECTURE.md 3.2) ---
# 회차당 좌석 화면 동시 입장 인원. 시연 때 1로 두면 두 번째 브라우저가 대기 화면을 본다
QUEUE_MAX_ACTIVE=100
# 입장 권한 유효 시간(초)
QUEUE_ADMIT_SECONDS=600
# 대기 중 폴링이 이만큼(초) 끊기면 대기열에서 제외
QUEUE_WAIT_TTL_SECONDS=30
# 좌석 임시 선점 시간(초). 연장 불가, 입장 만료를 넘지 않음
HOLD_SECONDS=300
# 폴링 엔드포인트(대기 상태·좌석 조회) 전용 요청 제한(IP당 분당)
RATE_LIMIT_POLL_PER_MINUTE=240

# --- 로그인 세션 (v3, 세션 저장소 = Redis) ---
# 요청이 없으면 이 시간(분) 뒤 세션 만료
SESSION_IDLE_MINUTES=30
# 운영(https)은 true(기본값). 로컬 http에서는 false여야 브라우저가 쿠키를 보낸다
SESSION_COOKIE_SECURE=false

# --- 시연 계정 (v3, migrate 모드에서만 사용. 둘 다 있을 때만 생성·갱신) ---
# 아래는 가짜 값입니다. 실제 비밀번호를 저장소에 적지 마세요.
# SEED_DEMO_EMAIL=demo@example.com
# SEED_DEMO_PASSWORD=change-me-demo-pw
# SEED_DEMO_NAME=시연 사용자
