eting-config · &lt;b&gt;Secret&lt;/b&gt; ticketing-secret&lt;br&gt;&lt;b&gt;NetworkPolicy&lt;/b&gt;: MySQL · Redis에는 backend · migrate만 접속" style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="510" y="455" width="420" height="60" as="geometry" /></mxCell><mxCell id="e1" value="HTTP :80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="browser" target="alb"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="/" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="alb" target="fesvc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="/api/*" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="alb" target="besvc"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="fesvc" target="fe"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;labelBackgroundColor=#FFFFFF;fontSize=11;" edge="1" parent="1" source="besvc" target="be"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="JDBC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#333333;labelBackgroundColor=#FFFFFF;fontSize=11;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" 