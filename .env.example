# 비밀번호는 저장소에 두지 않는다. 이 파일을 .env 로 복사해서 값을 채운다 (.env 는 .gitignore 로 제외된다).
#
#   cp .env.example .env        # 그다음 아래 값을 채운다. 무작위 값 예: openssl rand -hex 16
#
# local/ 스크립트, docker run --env-file, kubectl create secret --from-env-file 이 모두 이 파일을 읽는다.

# MySQL root 계정 (Docker 실행 때만 쓴다. WSL MySQL 은 sudo mysql 로 접속한다)
MYSQL_ROOT_PASSWORD=

# 스키마 소유자 계정 ticketing — 마이그레이션(테이블 생성·변경)에서만 쓴다
DB_OWNER_PASSWORD=

# API 서버 계정 ticketing_app — SELECT / INSERT / UPDATE 만 가진다
DB_APP_PASSWORD=

# Redis 비밀번호 (Docker 실행 때만 쓴다. WSL Redis 는 비밀번호 없이 127.0.0.1 에서만 열려 있다)
REDIS_PASSWORD=
